msgid "ce %s"
msgstr "this %s"

msgid "Le nom ne peut être vide"
msgstr "The name cannot be empty"

msgid "Le nom contient un des caractères non autorisé suivant : [ ] < > ;"
msgstr "The name contains one of the following forbidden characters: [ ] < > ;"

#, php-format
msgid "L'emplacement de <a href='/point/%s'>\"%s\"</a> et ses alentours sont privés.<br/> On ne peut pas y référencer de cabane.<br/> Voir : <a href=\"%s\">Définition d'une cabane non gardée</a>.<br/> Laissez-nous un message sur le forum si vous souhaitez en discuter.<br/>"
msgstr "The location of <a href='/point/%s'>\"%s\"</a> and its surroundings are private.<br/> A hut cannot be listed there.<br/> See: <a href=\"%s\">Definition of a wilderness hut</a>.<br/> Leave us a message on the forum if you would like to discuss it.<br/>"

#, php-format
msgid "La latitude du point doit être au format degré décimaux, par exemple : 45.789, la valeur reçue est : %s"
msgstr "The point's latitude must be in decimal degrees format, for example: 45.789; the value received is: %s"

#, php-format
msgid "La longitude du point doit être au format degré décimaux, par exemple : 45.789, la valeur reçue est : %s"
msgstr "The point's longitude must be in decimal degrees format, for example: 45.789; the value received is: %s"

msgid "La latitude du point doit être comprise entre -90 et 90 (degrés)"
msgstr "The point's latitude must be between -90 and 90 (degrees)"

msgid "La longitude du point doit être comprise entre -180 et 180 (degrés)"
msgstr "The point's longitude must be between -180 and 180 (degrees)"

#, php-format
msgid "L'altitude du point doit être un nombre entier positif, reçu : %s"
msgstr "The point's altitude must be a positive whole number, received: %s"

#, php-format
msgid "%sm comme altitude du point, c'est plus que l'Everest, vous avez dû vous tromper ?"
msgstr "%s m as the point's altitude is more than Everest; you must have made a mistake?"

#, php-format
msgid "Le nombre de %s doit être un entier supérieur ou égal à 0, reçu : '%s'"
msgstr "The number of %s must be a whole number greater than or equal to 0, received: '%s'"

#, php-format
msgid "Erreur de modification du point : %s"
msgstr "Error while modifying the point: %s"

msgid "La requête SQL est en erreur, mais nous ne savons pas pourquoi, prévenez nous sur le forum, vous avez trouvé un bug !"
msgstr "The SQL query failed and we do not know why, please let us know on the forum, you have found a bug!"

